# Copy to .env and fill in. Never commit the filled-in file.

# MongoDB connection string (local mongod, or a mongodb+srv:// Atlas URI)
MONGO_URI=mongodb://localhost:27017

# Signing key for API access tokens - use a long random value in any real deployment
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Activity queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost,http://localhost:3000

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Leave LOG_FILE unset to log to stdout.
LOG_LEVEL=INFO
# LOG_FILE=app.log
